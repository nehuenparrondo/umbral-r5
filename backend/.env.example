# Server runtime mode.
NODE_ENV=development

# API port used by Express.
PORT=4000

# Front-end origin allowed by CORS during local development.
CLIENT_ORIGIN=http://localhost:5173

# Public backend origin used to build exact OAuth callback URLs.
SERVER_ORIGIN=http://localhost:4000

# MySQL 8.0+; la API usa una cuenta SQL limitada, nunca root.
DATABASE_URL=mysql://umbral_r5_app:change-this-password@127.0.0.1:3307/umbral_r5
# Conexiones externas: exigir TLS y validar el certificado del proveedor.
DATABASE_SSL=false
# Aiven: contenido PEM del CA descargado desde su panel oficial, solo en el backend.
# Admite saltos de linea reales entre comillas o la secuencia escapada \n.
DATABASE_SSL_CA=

# Conexion de migracion con permisos CREATE; no usarla en la API si existe otra limitada.
DATABASE_MIGRATION_URL=

# Long random secret used to sign JWT access tokens. Use at least 32 characters.
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters

# Access token lifetime in minutes.
JWT_ACCESS_TTL_MINUTES=15

# Refresh token lifetime in days.
JWT_REFRESH_TTL_DAYS=7

# bcrypt work factor; 12 is a strong local default.
BCRYPT_SALT_ROUNDS=12

# Set true only when serving over HTTPS, or automatically in production.
COOKIE_SECURE=false

# Mailtrap: Email Sandbox > Integration > SMTP. Nunca subir credenciales reales.
EMAIL_TRANSPORT=smtp
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=cuentas@proyectouno.test

# Auth0 recomendado: una sola aplicacion Regular Web Application centraliza OAuth/OIDC.
# AUTH0_DOMAIN se copia sin https:// desde Settings > Basic Information.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_ENABLED_PROVIDERS=google,github

# Google y GitHub usan Auth0; Discord usa OAuth directo con sus claves de abajo.
# Microsoft queda como soporte opcional, fuera de la interfaz de entrega.
AUTH0_GOOGLE_CONNECTION=google-oauth2
AUTH0_MICROSOFT_CONNECTION=windowslive
AUTH0_FACEBOOK_CONNECTION=facebook
AUTH0_GITHUB_CONNECTION=github
AUTH0_DISCORD_CONNECTION=discord
AUTH0_TWITCH_CONNECTION=twitch
AUTH0_X_CONNECTION=twitter

# OAuth directo opcional/fallback. Auth0 tiene prioridad cuando sus tres credenciales estan completas.
# Si se usa el fallback, registrar cada callback exactamente como esta escrito.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/oauth/google/callback

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:4000/api/auth/oauth/facebook/callback
FACEBOOK_GRAPH_VERSION=v24.0

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:4000/api/auth/oauth/github/callback

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:4000/api/auth/oauth/discord/callback

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:4000/api/auth/oauth/twitch/callback

# X OAuth 2.0 may require a paid developer tier and does not expose email in /2/users/me.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:4000/api/auth/oauth/x/callback

# Optional first admin seed values used by backend/scripts/createAdmin.js.
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=

# Windows: npm run setup:local genera claves distintas en cada computadora.
# No hay una contrasena admin compartida en el repositorio.

# This file exports: example environment variables.
# It is used by: developers copying it to .env before running the app.
# It imports from: no project files.

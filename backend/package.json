{
  "name": "@r5/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API Express de R5. Autenticación, reglas de negocio y MySQL.",
  "scripts": {
    "dev": "node --watch --watch-preserve-output server.js",
    "start": "node server.js",
    "check": "node --check server.js",
    "lint": "eslint \"**/*.js\"",
    "test": "node --test tests/*.test.js",
    "db:create-admin": "node scripts/createAdmin.js",
    "db:migrate": "node scripts/migrateMySQL.js",
    "db:start": "node scripts/prepareDev.js",
    "setup:local": "node scripts/setupLocal.js",
    "db:stop": "node scripts/stopLocal.js",
    "doctor": "node scripts/doctor.js",
    "mail:check": "node scripts/checkMail.js",
    "oauth:check": "node scripts/checkOAuth.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jose": "^6.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.0.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0"
  }
}
